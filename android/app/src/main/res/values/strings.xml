<resources>
    <!-- Default FCM notification channel id. Referenced by the
         com.google.firebase.messaging.default_notification_channel_id
         meta-data in AndroidManifest.xml so notifications that don't name a
         channel are routed to a stable, named channel on Android 8+. -->
    <string name="default_notification_channel_id">recipe_default_channel</string>
</resources>
