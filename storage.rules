rules_version = '2';

// Cloud Storage security rules for the AI Recipe Generator.
//
// Avatars live at `avatars/{uid}.jpg` and are owner-writable, publicly
// readable (avatar URLs are shown in-app). Everything else is denied by
// default. Deploy with:
//   firebase deploy --only storage --project ai-recipe-generator-db27c
// (Cloud Storage must be enabled for the project first, in the Firebase
// console → Storage → Get started.)
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars: anyone can read; only the owner can write their own file,
    // capped at 5 MB and restricted to image content types.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName.matches(request.auth.uid + '\\.(jpg|jpeg|png|webp)')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
