# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Secrets / local dev config (holds the Gemini Developer API key).
# Commit env.example.json as the template; never commit the real key.
env.json

# Upload/release signing keystore. Leaking this lets anyone ship an update
# signed as this app, and Play will not let you change the key afterwards —
# it is unrecoverable, not merely sensitive. android/.gitignore already covers
# android/key.properties; these patterns cover the keystore itself wherever it
# is placed.
*.jks
*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
